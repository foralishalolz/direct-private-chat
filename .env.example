NEXT_PUBLIC_SUPABASE_URL=https://your-project-reference.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required to create an account. Share this only with people you want in the chat.
SIGNUP_INVITE_CODE=choose-your-own-invite-code

# ── Web Push notifications (optional — notifications are disabled without these)
# Generate a key pair with:  npx web-push generate-vapid-keys
# Keep the private key server-only; expose the public key to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:admin@example.com
