# ---- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-reference.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Signup ---------------------------------------------------------------
# Required to create an account. Share this only with people you want in.
SIGNUP_INVITE_CODE=choose-your-own-invite-code

# ---- Web Push (notifications) --------------------------------------------
# Generate a pair once, then paste both values here and in Vercel:
#   npx web-push generate-vapid-keys
# The public key is sent to the browser (it's safe to expose), the private key
# never leaves the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Cron -----------------------------------------------------------------
# Protects /api/cron/reminders. Any long random string; Vercel Cron sends it
# automatically as a bearer token when it matches this value.
CRON_SECRET=
